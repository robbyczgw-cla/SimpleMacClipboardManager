{
  "name": "simple-mac-clipboard-manager",
  "version": "0.14.0",
  "type": "module",
  "description": "A visual, privacy-focused clipboard manager for macOS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "package:mac:dir": "npm run build:app && electron-builder --mac dir",
    "package:mac:arm64": "npm run build:app && electron-builder --mac dmg zip --arm64",
    "package:mac:x64": "npm run build:app && electron-builder --mac dmg zip --x64",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dependency:audit": "npm audit --omit=dev --audit-level=moderate",
    "dependency:outdated": "npm outdated",
    "build:app": "tsc && vite build",
    "verify": "npm run typecheck && npm test && npm run build",
    "release:mac": "npm run build:app && electron-builder --mac dmg zip --arm64 --x64",
    "release": "npm run release:mac"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react-window": "^1.8.8",
    "dompurify": "^3.4.13",
    "electron-store": "^11.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
